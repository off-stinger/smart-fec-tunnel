# Shared tunnel settings. Copy to .env and never commit the real file.
SMART_FEC_KEY=replace-with-at-least-32-random-characters
SMART_FEC_KEY_ID=1
SMART_FEC_SERVER=203.0.113.10:443
SMART_FEC_RATE_MBPS=30

# Server-side loopback TUIC and WARP worker ports.
SMART_FEC_UPSTREAM=127.0.0.1:4443
SMART_WARP_BALANCE_LISTEN=127.0.0.1:18080
SMART_WARP_UPSTREAMS=127.0.0.1:18101 127.0.0.1:18102 127.0.0.1:18103

# Workstation orchestrator settings.
SERVER_SSH=root@203.0.113.10
OPENWRT_SSH=root@192.0.2.1
SERVER_IDENTITY_FILE=C:\path\to\server.pem
BINARY_PATH=.\dist\smart-fec-tunnel-linux-amd64
