[Unit]
Description=SFT authenticated QUIC carrier on UDP 443
After=network-online.target smart-fec-server.service
Wants=network-online.target
Requires=smart-fec-server.service

[Service]
Type=simple
ExecStart=/usr/local/bin/smart-fec-tunnel-alpha9 quic-server --listen 0.0.0.0:443 --upstream 127.0.0.1:8443 --cert /etc/smart-fec/quic-cert.pem --private-key /etc/smart-fec/quic-key.pem --keyring /etc/smart-fec/server.keys
Restart=always
RestartSec=2
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
LockPersonality=true
MemoryDenyWriteExecute=true

[Install]
WantedBy=multi-user.target
