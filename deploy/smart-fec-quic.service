[Unit]
Description=SFT authenticated QUIC carrier on UDP 443
After=network-online.target smart-fec-server.service
Wants=network-online.target
Requires=smart-fec-server.service

[Service]
Type=simple
Environment=SMART_QUIC_UPSTREAM=127.0.0.1:8443
# 0 is the default DATAGRAM carrier. Set to 1 on both peers only after
# validating the direct reliable-stream mode on the target path.
Environment=SMART_QUIC_STREAM_LANES=0
# Carrier congestion controller: new_reno (default) | cubic | bbr. Set it in
# /etc/smart-fec/quic.env (the EnvironmentFile below); the binary itself
# defaults to new_reno when the variable is absent, so no Environment= line is
# declared here on purpose. Congestion control is a sender-local decision and is
# not negotiated, so the two ends may run different controllers for a one-sided
# A/B. Compare the "QUIC carrier stats" lines: cwnd_bytes, congestion_events,
# wire_loss_ppm, mtu, black_holes.
EnvironmentFile=-/etc/smart-fec/quic.env
ExecStart=/usr/local/bin/smart-fec-tunnel-alpha9 quic-server --listen 0.0.0.0:443 --upstream ${SMART_QUIC_UPSTREAM} --cert /etc/smart-fec/quic-cert.pem --private-key /etc/smart-fec/quic-key.pem --keyring /etc/smart-fec/server.keys
Restart=always
RestartSec=2
TimeoutStopSec=5
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
LockPersonality=true
MemoryDenyWriteExecute=true

[Install]
WantedBy=multi-user.target
