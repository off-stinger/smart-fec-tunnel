#!/bin/sh /etc/rc.common
USE_PROCD=1
START=97
STOP=8

start_service() {
    procd_open_instance health-proxy
    procd_set_param command /tmp/etc/passwall/bin/sing-box run \
        -c /etc/smart-fec-health.json
    procd_set_param respawn 3600 5 5
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_close_instance

    procd_open_instance supervisor
    procd_set_param command /usr/sbin/smart-fec-supervisor
    procd_set_param env SMART_FEC_HEALTH_SOCKS=127.0.0.1:1071 \
        SMART_FEC_FAILURE_LIMIT=3 SMART_FEC_PROBE_INTERVAL=10 \
        SMART_FEC_RECOVERY_COOLDOWN=30
    procd_set_param respawn 3600 5 5
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_close_instance
}
